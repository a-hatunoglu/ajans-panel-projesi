# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://ajans_user:ajans_pass_2024@localhost:5432/ajans_panel

# ─── JWT ─────────────────────────────────────────────────────
# IMPORTANT: Change these in production! Use `openssl rand -hex 32` to generate.
JWT_ACCESS_SECRET=change-this-to-a-random-64-character-string-in-production-env
JWT_REFRESH_SECRET=change-this-to-another-random-64-character-string-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storage (S3-compatible) ─────────────────────────────────
# For local development with MinIO:
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET=minioadmin
STORAGE_S3_BUCKET=ajans-panel-files
STORAGE_S3_REGION=eu-central-1

# For production with AWS S3:
# STORAGE_S3_ACCESS_KEY=your-aws-access-key
# STORAGE_S3_SECRET=your-aws-secret-key
# STORAGE_S3_BUCKET=your-bucket-name
# STORAGE_S3_REGION=eu-central-1
# STORAGE_S3_ENDPOINT= (leave empty for AWS S3)

# ─── Email (SMTP) ───────────────────────────────────────────
# Leave empty for development — emails will be logged to console.
# In production, SMTP is REQUIRED (server exits if not configured).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com

# ─── App URLs ────────────────────────────────────────────────
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
