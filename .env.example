# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://ajans_user:ajans_pass_2024@localhost:5432/ajans_panel

# ─── JWT ──────────────────────────────────────────────────────
# IMPORTANT: Change these to cryptographically random 64+ char strings in production.
JWT_ACCESS_SECRET=change-this-to-a-random-64-character-string-in-production-env
JWT_REFRESH_SECRET=change-this-to-another-random-64-character-string-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storage (S3-compatible / MinIO) ─────────────────────────
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET=minioadmin
STORAGE_S3_BUCKET=ajans-panel-files
STORAGE_S3_REGION=eu-central-1

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# ─── App URLs ─────────────────────────────────────────────────
# APP_URL: The backend's own URL (used in health checks, email links pointing to API)
# CLIENT_URL: The frontend's URL (used in email templates, invite links, password reset links)
# CORS_ORIGINS: Comma-separated list of origins allowed to make credentialed requests
#   In production, CLIENT_URL and CORS_ORIGINS should reference the same frontend origin.
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
