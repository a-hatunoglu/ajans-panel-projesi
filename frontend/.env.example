# Optional for same-origin /api/v1 deployments.
# Required when the frontend talks to the backend on a different origin.
# This value is read at build time by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional server-side rewrite target for same-origin mode.
# Set backend origin without /api/v1, for example: https://api.example.com
# Leave empty if your platform-level reverse proxy already routes /api/v1.
API_REWRITE_TARGET=
